{
  "name": "rakibul-portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Md Rakibul Hassan, AI/ML Engineer and AI-Powered Software Developer. Static Astro site served from GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/serve-dist.mjs",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "extract:legacy": "node tests/extract-legacy-inventory.mjs",
    "test": "node --test tests/repo-hygiene.test.mjs tests/content-preservation.test.mjs tests/build-output.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:links": "node tests/external-links.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "playwright-core": "1.64.1"
  }
}
