---
import Base from '../layouts/Base.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Stats from '../components/sections/Stats.astro';
import Expertise from '../components/sections/Expertise.astro';
import Work from '../components/sections/Work.astro';
import { personJsonLd, seo } from '../data/portfolio';
---

<Base title={seo.title} description={seo.description} path="/" jsonLd={[personJsonLd]}>
  <Header />
  <main id="main">
    <Hero />
    <Stats />
    <Expertise />
    <Work />
  </main>
</Base>
