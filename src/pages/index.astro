---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
---

<Base title="Md Rakibul Hassan" description="Scaffold" path="/">
  <main id="main" class="mx-auto max-w-6xl px-6 py-24 sm:px-8">
    <h1 class="font-display text-5xl font-bold">Scaffold</h1>
    <SectionHeading eyebrow="Eyebrow" title="Section title" id="t" lead="Lead text." />
    <Button href="/#main" icon="arrow-right">
      Primary
    </Button>
  </main>
</Base>
