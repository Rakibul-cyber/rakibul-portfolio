---
import Base from '../layouts/Base.astro';
import Button from '../components/ui/Button.astro';
---

<Base
  title="Page not found — Md Rakibul Hassan"
  description="This page doesn’t exist."
  path="404/"
  noindex
>
  <main id="main" class="relative flex min-h-dvh items-center">
    <div class="hero-grid nf-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-xl px-6 py-24 text-center">
      <p class="font-mono text-sm font-medium text-accent-600">404</p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Page not found
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        The page you’re looking for doesn’t exist or has moved. Everything on this site is on the
        home page.
      </p>
      <div class="mt-8 flex justify-center">
        <Button href="/" icon="arrow-right">
          Back to the home page
        </Button>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf-grid {
    mask-image: radial-gradient(60% 60% at 50% 45%, #000 20%, transparent 75%);
  }
</style>
