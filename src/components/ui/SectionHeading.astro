---
export interface Props {
  eyebrow: string;
  title: string;
  /** Heading id, referenced by the section's aria-labelledby. */
  id: string;
  lead?: string;
  level?: 'h2' | 'h3';
  class?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, id, lead, level = 'h2', class: className, align = 'left' } = Astro.props;
const Tag = level;
---

<div class:list={['max-w-2xl', align === 'center' && 'mx-auto text-center', className]} data-reveal>
  <p class="font-display text-sm font-semibold tracking-eyebrow text-accent uppercase">{eyebrow}</p>
  <Tag
    id={id}
    class="mt-3 font-display text-3xl leading-tight font-bold tracking-tight text-balance text-ink sm:text-4xl sm:leading-10"
  >
    {title}
  </Tag>
  {lead && <p class="mt-5 text-lg leading-relaxed text-pretty text-muted">{lead}</p>}
  <slot />
</div>
