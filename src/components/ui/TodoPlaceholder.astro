---
/**
 * Visible placeholder for content the owner must supply. `npm run check:deploy`
 * fails while any `data-todo` marker remains in the build, so it can't go live.
 */
export interface Props {
  id: string;
}
const { id } = Astro.props;
---

<span
  data-todo={id}
  class="inline-block rounded-lg border border-dashed border-amber-500 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-900"
>
  <slot />
</span>
