---
import Icon from '../ui/Icon.astro';
import Tag from '../ui/Tag.astro';
import type { Project } from '../../data/portfolio';
import { categoryLabels } from '../../data/portfolio';

export interface Props {
  project: Project;
}
const { project } = Astro.props;
const cs = project.caseStudy;
// Inline `code` spans in data are rendered as <code>; everything else is escaped.
const withCode = (text: string) =>
  text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(
      /`([^`]+)`/g,
      '<code class="rounded bg-surface px-1 py-0.5 font-mono text-[0.85em] text-ink">$1</code>',
    );
---

{cs && (
  <article
    id={`project-${project.id}`}
    aria-labelledby={`title-${project.id}`}
    class="overflow-hidden rounded-3xl border border-slate-200/80 bg-white shadow-sm"
    data-reveal
  >
    <header class="relative border-b border-slate-100 p-7 sm:p-10">
      <div class="case-glow pointer-events-none absolute inset-0" aria-hidden="true" />
      <div class="relative">
        <div class="flex flex-wrap items-center gap-2">
          <Tag tone="accent">{cs.kicker}</Tag>
          {project.categories.map((c) => (
            <Tag tone="outline">{categoryLabels[c]}</Tag>
          ))}
          <Tag tone="outline">Status: {project.status}</Tag>
        </div>
        <h3
          id={`title-${project.id}`}
          class="mt-5 max-w-3xl font-display text-2xl leading-tight font-bold tracking-tight text-balance text-ink sm:text-3xl"
        >
          {project.title}
        </h3>
        <p class="mt-4 max-w-3xl text-base leading-relaxed text-pretty text-muted sm:text-lg">
          {project.description}
        </p>
        <ul class="mt-6 flex flex-wrap gap-3">
          {cs.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="group inline-flex min-h-11 items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-ink transition-colors hover:border-slate-300"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name={link.label === 'Repository' ? 'github' : 'pipeline'} class="size-4" />
                {link.label}
                <Icon name="arrow-up-right" class="nudge-diag size-3.5 text-slate-400" />
                <span class="sr-only">(opens GitHub)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-10 p-7 sm:p-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <div class="space-y-8">
        <section>
          <h4 class="case-label">Problem</h4>
          <p class="mt-2 leading-relaxed text-slate-700">{cs.problem}</p>
        </section>
        <section>
          <h4 class="case-label">My role</h4>
          <p class="mt-2 leading-relaxed text-slate-700">{cs.role}</p>
        </section>
        <section>
          <h4 class="case-label">Approach</h4>
          <ol class="mt-3 space-y-2.5">
            {cs.approach.map((step, i) => (
              <li class="flex gap-3 leading-relaxed text-slate-700">
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-ink font-mono text-xs text-white">
                  {i + 1}
                </span>
                {step}
              </li>
            ))}
          </ol>
        </section>
      </div>

      <section aria-labelledby={`arch-${project.id}`}>
        <h4 id={`arch-${project.id}`} class="case-label">
          Architecture
        </h4>
        <ol class="arch mt-3 rounded-2xl border border-slate-200/80 bg-surface p-5">
          {cs.architecture.map((step) => (
            <li class="arch-step relative flex items-center gap-3 rounded-xl border border-slate-200/80 bg-white px-4 py-3">
              <span class="size-2 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              <span class="min-w-0">
                <span class="block font-mono text-sm font-semibold text-ink">{step.label}</span>
                {step.detail && <span class="block text-xs text-muted">{step.detail}</span>}
              </span>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <section
      class="border-t border-slate-100 p-7 sm:p-10"
      aria-labelledby={`challenges-${project.id}`}
    >
      <h4 id={`challenges-${project.id}`} class="case-label">
        Engineering challenges
      </h4>
      <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
        {cs.challenges.map((c) => (
          <li class="rounded-2xl border border-slate-200/80 p-5">
            <p class="font-display font-semibold text-ink">{c.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted" set:html={withCode(c.body)} />
          </li>
        ))}
      </ul>
    </section>

    <div class="grid grid-cols-1 gap-10 border-t border-slate-100 p-7 sm:p-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <section>
        <h4 class="case-label">Model</h4>
        <ul class="mt-3 space-y-2.5">
          {cs.model.map((m) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
              <Icon name="check" class="mt-1 size-4 text-accent" strokeWidth={2.25} />
              <span>{m}</span>
            </li>
          ))}
        </ul>
        <h4 class="case-label mt-8">Tech stack</h4>
        <ul class="mt-3 flex flex-wrap gap-2">
          {cs.stack.map((t) => (
            <li>
              <Tag>{t}</Tag>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby={`eval-${project.id}`}>
        <h4 id={`eval-${project.id}`} class="case-label">
          Evaluation
        </h4>
        <div class="mt-3 overflow-x-auto rounded-2xl border border-slate-200/80">
          <table class="w-full min-w-[20rem] text-left text-sm">
            <caption class="border-b border-slate-200/80 bg-surface px-4 py-3 text-left text-xs leading-relaxed text-muted">
              {cs.evaluation.caption}
            </caption>
            <thead>
              <tr class="border-b border-slate-200/80 text-xs tracking-wide text-slate-500 uppercase">
                <th scope="col" class="px-4 py-3 font-semibold">
                  Metric
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  LOSO CV <span class="font-normal normal-case">(realistic)</span>
                </th>
                <th scope="col" class="px-4 py-3 font-semibold">
                  Held-out
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 font-mono">
              {cs.evaluation.rows.map((row) => (
                <tr>
                  <th scope="row" class="px-4 py-2.5 font-sans font-medium text-ink">
                    {row.metric}
                  </th>
                  <td class="px-4 py-2.5 font-semibold text-accent-600">{row.loso}</td>
                  <td class="px-4 py-2.5 text-slate-700">{row.heldOut}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="mt-4 space-y-2">
          {cs.evaluation.notes.map((n) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
              <Icon name="info" class="mt-0.5 size-4 text-accent" />
              {n}
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-slate-500">Source: {cs.evaluation.source}</p>
      </section>
    </div>

    <div class="grid grid-cols-1 gap-10 border-t border-slate-100 p-7 sm:p-10 lg:grid-cols-2">
      <section>
        <h4 class="case-label">Testing &amp; deployment</h4>
        <ul class="mt-3 space-y-2.5">
          {cs.testing.map((t) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
              <Icon name="check" class="mt-1 size-4 text-accent" strokeWidth={2.25} />
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <h4 class="case-label mt-8">Outcome</h4>
        <ul class="mt-3 space-y-2.5">
          {cs.outcome.map((o) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
              <Icon name="check-circle" class="mt-0.5 size-4 text-emerald-600" />
              <span>{o}</span>
            </li>
          ))}
        </ul>
      </section>

      <section
        class="rounded-2xl border border-dashed border-accent/40 bg-accent-50/50 p-6"
        aria-labelledby={`limits-${project.id}`}
      >
        <h4
          id={`limits-${project.id}`}
          class="flex items-center gap-2 font-display font-semibold text-accent-600"
        >
          <Icon name="info" class="size-5" />
          Limitations, stated plainly
        </h4>
        <ul class="mt-4 space-y-2.5">
          {cs.limitations.map((l) => (
            <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
              {l}
            </li>
          ))}
        </ul>
      </section>
    </div>
  </article>
)}

<style>
  .case-label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-slate-500);
  }
  .case-glow {
    background: radial-gradient(
      50% 120% at 100% 0,
      color-mix(in srgb, var(--color-violet) 10%, transparent),
      transparent 70%
    );
  }
  /* Connector between architecture steps. */
  .arch {
    display: grid;
    gap: 0.75rem;
  }
  .arch-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.25rem;
    bottom: -0.8rem;
    width: 1px;
    height: 0.85rem;
    background: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }
</style>
