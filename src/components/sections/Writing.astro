---
/**
 * Writing section (brief §6.8). Renders only articles that are `published` and
 * have a URL to a full body. None qualifies today, so this renders nothing.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import { publishedArticles } from '../../data/portfolio';
import { withBase } from '../../lib/url';
---

{publishedArticles.length > 0 && (
  <section
    id="writing"
    aria-labelledby="writing-title"
    class="border-t border-slate-200/70 py-24 sm:py-32"
  >
    <div class="mx-auto max-w-6xl px-6 sm:px-8">
      <SectionHeading id="writing-title" eyebrow="Writing" title="Notes from building things." />
      <ul class="mt-12 grid gap-5 md:grid-cols-2">
        {publishedArticles.map((a) => (
          <li class="rounded-2xl border border-slate-200/80 bg-white p-6">
            <p class="text-xs text-slate-600">
              {a.tag} · {a.date} · {a.readTime}
            </p>
            <h3 class="mt-3 font-display text-lg font-semibold text-ink">
              <a href={withBase(a.url ?? '/')} class="hover:text-accent-600">
                {a.title}
              </a>
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{a.excerpt}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
