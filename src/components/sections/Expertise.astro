---
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { expertise, legacySkills, resumeSkills, visibleProjects } from '../../data/portfolio';

const shortTitle = (id: string) => visibleProjects.find((p) => p.id === id)?.shortTitle ?? id;
// "Shown in" lists only projects that are rendered; hidden projects keep their data entry.
const isVisible = (id: string) => visibleProjects.some((p) => p.id === id);
const skillGroups = [
  ...[...new Set(legacySkills.map((s) => s.category))].map((category) => ({
    category,
    names: legacySkills.filter((s) => s.category === category).map((s) => s.name),
  })),
  // Toolkit only: these have no project evidence on this site, so they never appear on the cards.
  ...resumeSkills,
];
---

<section id="expertise" aria-labelledby="expertise-title" class="py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <SectionHeading
      id="expertise-title"
      eyebrow="What I do"
      title="Machine learning that ships as software."
      lead="Machine learning is my focus and what my newest work shows. Mobile, backend and DevOps experience is what makes it dependable: a model is one part of a system that has to be called, tested and released."
    />

    <ul class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2">
      {expertise.map((item, i) => (
        <Card
          as="li"
          interactive
          class="flex flex-col"
          data-reveal
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <span class="flex size-12 items-center justify-center rounded-xl bg-accent-50 text-accent">
            <Icon name={item.icon} class="size-6" />
          </span>
          <p class="mt-6 text-sm font-semibold text-accent">{item.kicker}</p>
          <h3 class="mt-1.5 font-display text-xl leading-7 font-semibold text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.summary}</p>
          <ul class="mt-5 space-y-2.5 border-t border-slate-100 pt-5">
            {item.points.map((point) => (
              <li class="flex gap-2.5 text-sm leading-snug text-slate-700">
                <Icon name="check" class="mt-0.5 size-4 text-accent" strokeWidth={2.25} />
                {point}
              </li>
            ))}
          </ul>
          <p class="mt-auto flex flex-wrap items-center gap-x-1 gap-y-1 pt-6 text-sm">
            <span class="mr-1 text-slate-500">Shown in</span>
            {item.shownIn.filter(isVisible).map((id, n, shown) => (
              <>
                <a
                  href={`#project-${id}`}
                  class="inline-flex min-h-8 items-center font-medium text-accent-600 underline decoration-accent/30 underline-offset-4 hover:decoration-accent"
                >
                  {shortTitle(id)}
                </a>
                {n < shown.length - 1 && (
                  <span class="text-slate-400" aria-hidden="true">
                    ·
                  </span>
                )}
              </>
            ))}
          </p>
        </Card>
      ))}
    </ul>

    <div class="mt-10 rounded-2xl border border-slate-200/80 bg-surface p-6 sm:p-8" data-reveal>
      <h3 class="font-display text-xs font-semibold tracking-label text-slate-600 uppercase">
        Full toolkit
      </h3>
      <div class="mt-5 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {skillGroups.map((group) => (
          <div>
            <h4 class="text-sm font-semibold text-ink">{group.category}</h4>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.names.map((name) => (
                <li class="rounded-full border border-slate-200/80 bg-white px-3 py-1 text-sm text-slate-700">
                  {name}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
