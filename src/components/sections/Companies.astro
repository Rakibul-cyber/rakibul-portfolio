---
import CompanyCard from '../ui/CompanyCard.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { companies } from '../../data/portfolio';
---

<section
  id="companies"
  aria-labelledby="companies-title"
  class="border-b border-slate-200/70 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <SectionHeading
      id="companies-title"
      eyebrow="Selected companies"
      title="Companies I’ve worked with."
      lead="Where I’ve been employed as a developer or research assistant. These are employers, not clients."
    />

    <ul
      class="mt-12 grid grid-cols-1 gap-px overflow-hidden rounded-2xl border border-slate-200/80 bg-slate-200/80 shadow-sm sm:grid-cols-2 lg:grid-cols-4"
      data-reveal
    >
      {companies.map((company) => (
        <li>
          <CompanyCard company={company} />
        </li>
      ))}
    </ul>
  </div>
</section>
