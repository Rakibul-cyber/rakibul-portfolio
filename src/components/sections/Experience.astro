---
import Icon from '../ui/Icon.astro';
import { education, experience, transitionNote } from '../../data/portfolio';
---

<section id="experience" aria-labelledby="experience-title" class="bg-surface py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-14 px-6 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
      <p class="font-display text-sm font-semibold tracking-eyebrow text-accent uppercase">
        Experience
      </p>
      <h2
        id="experience-title"
        class="mt-3 font-display text-3xl leading-tight font-bold tracking-tight text-balance text-ink sm:text-4xl sm:leading-10"
      >
        {transitionNote.title}
      </h2>
      {transitionNote.body.map((p) => (
        <p class="mt-5 text-lg leading-relaxed text-pretty text-muted">{p}</p>
      ))}
    </div>

    <div>
      <ol class="relative space-y-5 border-l border-slate-200 pl-8">
        {experience.map((job, i) => (
          <li class="relative" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
            <span
              class="absolute top-7 -left-[2.3rem] flex size-3 rounded-full bg-accent ring-4 ring-surface"
              aria-hidden="true"
            />
            <article class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm sm:p-7">
              <p class="font-mono text-xs font-medium text-accent-600">{job.period}</p>
              <h3 class="mt-2 font-display text-lg font-semibold text-ink">{job.role}</h3>
              <p class="mt-0.5 text-sm text-muted">
                {job.org} · {job.location}
              </p>
              <ul class="mt-4 space-y-2">
                {job.points.map((point) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-slate-700">
                    <span
                      class="mt-2 size-1.5 shrink-0 rounded-full bg-slate-300"
                      aria-hidden="true"
                    />
                    {point}
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))}
      </ol>

      <h3 class="mt-12 flex items-center gap-2 font-display text-xs font-semibold tracking-label text-slate-600 uppercase">
        <Icon name="cap" class="size-4" />
        Education
      </h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {education.map((edu) => (
          <li class="rounded-2xl border border-slate-200/80 bg-white p-5" data-reveal>
            <p class="font-mono text-xs font-medium text-accent-600">{edu.period}</p>
            <p class="mt-2 font-display font-semibold text-ink">{edu.degree}</p>
            <p class="mt-0.5 text-sm text-muted">{edu.school}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
