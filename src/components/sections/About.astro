---
import { Picture } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import {
  about,
  certifications,
  languages,
  learning,
  profile,
  publications,
} from '../../data/portfolio';
---

<section
  id="about"
  aria-labelledby="about-title"
  class="border-t border-slate-200/70 py-24 sm:py-32"
>
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-6 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-x-16 lg:gap-y-14">
    <!-- Below lg: a 4:5 portrait above the text. From lg: the photo fills the full height of the intro row. -->
    <div
      class="about-visual relative mx-auto aspect-[4/5] w-full max-w-md overflow-hidden rounded-2xl border border-slate-200/80 bg-surface lg:mx-0 lg:aspect-auto lg:min-h-[32rem] lg:max-w-none"
      data-reveal
    >
      {profile.aboutPhoto ? (
        <Picture
          src={profile.aboutPhoto.src}
          alt={profile.aboutPhoto.alt}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 800, 960]}
          sizes="(min-width: 64rem) 480px, (min-width: 30rem) 448px, calc(100vw - 3rem)"
          pictureAttributes={{ class: 'absolute inset-0 block size-full' }}
          class="about-photo size-full object-cover"
          style={
            profile.aboutPhoto.position
              ? `object-position: ${profile.aboutPhoto.position}`
              : undefined
          }
        />
      ) : (
        <div
          class="absolute inset-0 flex items-center justify-center bg-white"
          role="img"
          aria-label={`${profile.name} monogram`}
        >
          <span class="font-display text-8xl font-bold tracking-tight text-gradient">
            {profile.monogram}
          </span>
        </div>
      )}
    </div>

    <div data-reveal>
      <div>
        <p class="font-display text-sm font-semibold tracking-eyebrow text-accent uppercase">
          {about.eyebrow}
        </p>
        <h2
          id="about-title"
          class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl"
        >
          {profile.name}
        </h2>
        <p class="mt-2 font-display text-base font-semibold text-accent-600">{profile.role}</p>
        {about.paragraphs.map((p) => (
          <p class="mt-5 text-lg leading-relaxed text-pretty text-muted">{p}</p>
        ))}
      </div>
    </div>

    <div
      class="grid grid-cols-1 gap-x-8 gap-y-8 border-t border-slate-200/70 pt-10 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-4"
      data-reveal
    >
      <div>
        <h3 class="about-label">
          <Icon name="award" class="size-4" />
          Certifications
        </h3>
        <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
          {certifications.map((c) => (
            <li>{c}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="about-label">
          <Icon name="book" class="size-4" />
          Currently learning
        </h3>
        <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
          {learning.map((l) => (
            <li>{l}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="about-label">
          <Icon name="file" class="size-4" />
          Publications
        </h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-700">
          {publications.map((p) => (
            <li>
              {p.url ? (
                <a
                  href={p.url}
                  class="underline decoration-slate-300 underline-offset-4 hover:text-accent-600 hover:decoration-accent"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {p.title}
                  <span class="sr-only"> (opens the journal article)</span>
                </a>
              ) : (
                p.title
              )}
              {p.year && <span class="text-muted"> ({p.year})</span>}
              {p.status && <span class="text-muted"> ({p.status})</span>}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="about-label">
          <Icon name="globe" class="size-4" />
          Languages
        </h3>
        <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
          {languages.map((l) => (
            <li>
              {l.name} <span class="text-muted">· {l.level}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-slate-600);
  }
</style>
