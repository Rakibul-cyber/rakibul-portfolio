---
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import {
  about,
  certifications,
  languages,
  learning,
  profile,
  publications,
} from '../../data/portfolio';
---

<section
  id="about"
  aria-labelledby="about-title"
  class="border-t border-slate-200/70 py-24 sm:py-32"
>
  <div class="mx-auto grid max-w-6xl items-start gap-14 px-6 sm:px-8 lg:grid-cols-2 lg:gap-16">
    <div class="about-visual relative mx-auto aspect-square w-full max-w-md" data-reveal>
      <div class="hero-grid about-grid absolute inset-0" aria-hidden="true"></div>
      <div class="about-glow absolute inset-0" aria-hidden="true"></div>
      <div class="absolute inset-[16%]">
        {profile.photo ? (
          <Image
            src={profile.photo.src}
            alt={profile.photo.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 64rem) 320px, 60vw"
            class="size-full rounded-full object-cover shadow-2xl ring-4 shadow-slate-300/50 ring-white"
          />
        ) : (
          <div
            class="relative flex size-full items-center justify-center overflow-hidden rounded-full bg-white shadow-2xl ring-4 shadow-slate-300/50 ring-white"
            role="img"
            aria-label={`${profile.name} monogram`}
          >
            <span class="font-display text-8xl font-bold tracking-tight text-gradient">
              {profile.monogram}
            </span>
          </div>
        )}
      </div>
    </div>

    <div>
      <div data-reveal>
        <p class="font-display text-sm font-semibold tracking-eyebrow text-accent uppercase">
          {about.eyebrow}
        </p>
        <h2
          id="about-title"
          class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl"
        >
          {profile.name}
        </h2>
        <p class="mt-2 font-display text-base font-semibold text-accent-600">{profile.role}</p>
        {about.paragraphs.map((p) => (
          <p class="mt-5 text-lg leading-relaxed text-pretty text-muted">{p}</p>
        ))}
      </div>

      <div class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2" data-reveal>
        <div>
          <h3 class="about-label">
            <Icon name="award" class="size-4" />
            Certifications
          </h3>
          <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
            {certifications.map((c) => (
              <li>{c}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="about-label">
            <Icon name="book" class="size-4" />
            Currently learning
          </h3>
          <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
            {learning.map((l) => (
              <li>{l}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="about-label">
            <Icon name="file" class="size-4" />
            Publications
          </h3>
          <ul class="mt-3 space-y-2 text-sm text-slate-700">
            {publications.map((p) => (
              <li>
                {p.title}
                {p.year && <span class="text-muted"> ({p.year})</span>}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="about-label">
            <Icon name="globe" class="size-4" />
            Languages
          </h3>
          <ul class="mt-3 space-y-1.5 text-sm text-slate-700">
            {languages.map((l) => (
              <li>
                {l.name} <span class="text-muted">· {l.level}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    mask-image: radial-gradient(closest-side, #000 40%, transparent 100%);
  }
  .about-glow {
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-accent) 14%, transparent),
      transparent 75%
    );
  }
  .about-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-slate-600);
  }
</style>
