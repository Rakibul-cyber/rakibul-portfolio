---
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import groteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { absoluteUrl, withBase } from '../lib/url';

export interface Props {
  title: string;
  description: string;
  /** Path of this page relative to the site base, e.g. '/' or 'privacy/'. */
  path: string;
  lang?: string;
  noindex?: boolean;
  /** Structured data objects rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, lang = 'en', noindex = false, jsonLd = [] } = Astro.props;
const canonical = absoluteUrl(path, Astro.site);

// Latin subsets only (TD-04). Declared here rather than in CSS so the display
// face, which renders the hero headline, can be preloaded with the same URL.
const latinRange =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontFaces = `
@font-face{font-family:'Inter Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${interLatin}) format('woff2-variations');unicode-range:${latinRange}}
@font-face{font-family:'Space Grotesk Variable';font-style:normal;font-display:swap;font-weight:300 700;src:url(${groteskLatin}) format('woff2-variations');unicode-range:${latinRange}}`;
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#fcfcfd" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />

    <link rel="preload" href={groteskLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFaces} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Md Rakibul Hassan" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {jsonLd.map((data) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
  </head>
  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only z-[100] rounded-full bg-ink px-5 py-3 text-sm font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
