---
import Base from './Base.astro';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  heading: string;
  updated: string;
}
const { title, description, path, lang = 'en', heading, updated } = Astro.props;
---

<Base title={title} description={description} path={path} lang={lang} noindex>
  <Header home={false} />
  <main id="main" class="relative">
    <div
      class="hero-grid legal-grid pointer-events-none absolute inset-x-0 top-0 h-80"
      aria-hidden="true"
    ></div>
    <article class="legal relative mx-auto max-w-3xl px-6 pt-32 pb-24 sm:px-8 sm:pt-40">
      <h1 class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">{heading}</h1>
      <p class="mt-3 text-sm text-slate-600">{updated}</p>
      <slot />
    </article>
  </main>
  <Footer home={false} />
</Base>

<style>
  .legal-grid {
    mask-image: radial-gradient(70% 100% at 50% 0, #000 20%, transparent 75%);
  }
  .legal :global(h2) {
    margin-top: 2.5rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal :global(h3) {
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal :global(p),
  .legal :global(li),
  .legal :global(address) {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: var(--color-slate-700);
    font-style: normal;
  }
  .legal :global(ul) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(a) {
    color: var(--color-accent-600);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
